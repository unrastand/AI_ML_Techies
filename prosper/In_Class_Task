# Question 1 - 4 and 7
import numpy as np

#Array Creation
numbers_1D = np.arange(1, 51)
print("\n1D Array:")
print(numbers_1D)

#Reshaping
reshape_2D = numbers_1D.reshape(5,10)
print("\n2D Reshape:")
print(reshape_2D)

#Slicing and Indexing
print("\nSlicing:") 
print(reshape_2D[2:5, 3:7])  # Slice a 2D array

#Extraction of 3rd row
print("\n3rd Row:")
print(reshape_2D[2, :])  # Extract the 3rd row

#Extraction of 4th column of 2nd row
print("\n4th Column of 2nd Row is:", reshape_2D[1, 3])

#Multiplication of 2D array by 3.14
multiplied_array = (np.round(reshape_2D * 3.14).astype(int))
print("\nMultiplied Array:")
print(multiplied_array)

cal_mean = np.mean(reshape_2D)
cal_median = np.median(reshape_2D)
print("\nMean of the 2D array is:", cal_mean)
print("\nMedian of the 2D array is:", cal_median)


